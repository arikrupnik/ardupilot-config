# config.param: settigns that reflect choices one makes on the bench
#
# Boxkite: tailsitter quadplane biplane
# MatekSys H743-WLITE
# Arduplane 4.7.0
#
MAV_SYSID,33
#
# LUA Scripting
SCR_ENABLE,0
#
# IMU installation
# Pitch180Roll270
AHRS_ORIENTATION,32
# "X position of the first IMU Accelerometer in body frame. Positive X is forward of the origin."
INS_POS1_X,0.02
# "Y position of the first IMU accelerometer in body frame. Positive Y is to the right of the origin."
INS_POS1_Y,0.01
# "Z position of the first IMU accelerometer in body frame. Positive Z is down from the origin."
INS_POS1_Z,0
#
# QPlane configuration
Q_ENABLE,1
# tailsitter
Q_TAILSIT_ENABLE,1
# quad
Q_FRAME_CLASS,1
# X frame
Q_FRAME_TYPE,1
# all lifter motors active in fixed-wing mode
Q_TAILSIT_MOTMX,15
# The airframe is incapabe of RoG takeoff: "ARMVTOL-arm only in VTOL modes (or AUTO mode when current nav cmd is VTOL Takeoff)"
Q_OPTIONS,262144
#
# INPUTS
#
# serial ports
# USB console
SERIAL0_PROTOCOL,2
# (UART7, default: TELEM1)
SERIAL1_PROTOCOL,-1
# (USART1, next to S2)
SERIAL2_PROTOCOL,-1
# GPS (USART2, default)
SERIAL3_PROTOCOL,5
SERIAL3_OPTIONS,0
# (USART3, next to UART6 RCIN)
SERIAL4_PROTOCOL,-1
# (UART8, next to S1)
SERIAL5_PROTOCOL,-1
# (UART4, Rx4 in S1/S2, Tx4 on test point)
SERIAL6_PROTOCOL,-1
# ELRS RC+TELEM (UART6, default: RCIN)
SERIAL7_PROTOCOL,2
SERIAL7_BAUD,460
# use full SERIAL7 port
BRD_ALT_CONFIG,1
#
# battery--analog, voltage & current
BATT_MONITOR,4
BATT_VOLT_PIN,10
BATT_VOLT_MULT,21
BATT_CURR_PIN,11
BATT_AMP_PERVLT,66.7
BATT_CAPACITY,1300
#
# airspeed: none
ARSPD_TYPE,0
#
# OUTPUTS
#SERVO_BLH_OTYPE,5
# [B]DShot600 on lifter motors
Q_M_PWM_TYPE,6
# telemetry type: BLHeli32/AM32/Kiss+EDT
SERVO_DSHOT_ESC,3
# bitmask of bi-directional dshot channels: all four ESCs
SERVO_BLH_BDMASK,15
# AM32 serial pass-thru auto-enable
SERVO_BLH_AUTO,1
# Motor2 (C), rear/top     left,  CCW
SERVO1_FUNCTION,34
# Motor4 (B), back/top     right,  CW
SERVO2_FUNCTION,36
# Motor1 (A), front/bottom right, CCW
SERVO3_FUNCTION,33
# Motor3 (D), front/bottom left,   CW
SERVO4_FUNCTION,35
# all four motors ended up with wiring for reverse rotation
SERVO_BLH_RVMASK,15
#
# SERVO5/6 are part of the 3/4/5/6 Dshot group; skip them
SERVO5_FUNCTION,0
SERVO6_FUNCTION,0
#
# top right elevon
SERVO7_FUNCTION,78
SERVO7_MAX,1900
SERVO7_TRIM,1700
SERVO7_MIN,1100
SERVO7_REVERSED,1
# top left elevon
SERVO8_FUNCTION,77
SERVO8_MAX,1900
SERVO8_TRIM,1300
SERVO8_MIN,1100
SERVO8_REVERSED,0
# bottom right elevon
SERVO9_FUNCTION,78
SERVO9_MAX,1900
SERVO9_TRIM,1700
SERVO9_MIN,1100
SERVO9_REVERSED,1
# bottom left elevon
SERVO10_FUNCTION,77
SERVO10_MAX,1900
SERVO10_TRIM,1300
SERVO10_MIN,1100
SERVO10_REVERSED,0
#
# Q tuning based on battery and prop size (5", but using 7" as proxy fror size)
# from https://ardupilot.org/copter/docs/setting-up-for-tuning.html
# and Mission Planer InitialTune page
#
# linearize throttle response
Q_M_BAT_VOLT_MAX,12.6
Q_M_BAT_VOLT_MIN,9.9
Q_M_THST_EXPO,0.54
# "Point at which the motors start to spin"
Q_M_SPIN_ARM,0.04
# "Point at which the thrust starts" (measured)
Q_M_SPIN_MIN,0.2
# "Point at which the thrust saturates" (default)
Q_M_SPIN_MAX,0.95
# "Motor thrust needed to hover" (default)
Q_M_THST_HOVER,0.35
#
# lowpass filters
INS_ACCEL_FILTER,10
INS_GYRO_FILTER,57
#
# "PID Controller Initial Setup"
Q_A_ACC_P_MAX,1300
Q_A_ACC_R_MAX,1300
Q_A_ACC_Y_MAX,300
Q_A_RAT_PIT_FLTD,28.5
Q_A_RAT_PIT_FLTT,28.5
Q_A_RAT_RLL_FLTD,28.5
Q_A_RAT_RLL_FLTT,28.5
Q_A_RAT_YAW_FLTE,2
# MP suggests RAT_YAW_FLTD=0
Q_A_RAT_YAW_FLTD,28.5
Q_A_RAT_YAW_FLTT,28.5
#
# Harmonic Notch Filter
INS_HNTCH_ENABLE,1
# ESC telemetry
INS_HNTCH_MODE,3
# "For RPM and ESC telemetry based tracking, this parameter is set to 1 to enable the Harmonic Notch Filter
INS_HNTCH_REF,1
# only 1st harmonic
INS_HNTCH_HMNCS,1
# bit 1: "in the case of ESC it will attach notches to each of four motor RPM values"
INS_HNTCH_OPTS,2
# default
INS_HNTCH_FREQ,80
# default
INS_HNTCH_BW,40
# default
INS_HNTCH_ATT,40
# default
INS_HNTCH_FM_RAT,1
#
#
# FBWA
AUTOTUNE_LEVEL,6
# estimate of level-flight AoA for KF2 airfoil and draggy airframe
PTCH_TRIM_DEG,5
# allow full roll demand at any airspeed
STALL_PREVENTION,0
#
# FBWB
#
#
# AUTO
# stick inputs active in auto modes
STICK_MIXING,1
#
TERRAIN_ENABLE,0
WP_LOITER_RAD,30
WP_MAX_RADIUS,0
WP_RADIUS,90
#
## RTL
##RALLY_INCL_HOME,0
#RALLY_LIMIT_KM,0.5
#RTL_AUTOLAND,0
#RTL_CLIMB_MIN,0
## "If this is zero then WP_LOITER_RAD is used."
#RTL_RADIUS,0
## altitude target for RTL (cm?)
#RTL_ALTITUDE,100
